# ==============================================================================
# ScribePy — Configuration Template (.env)
# ==============================================================================

# --- Configurações de Roteamento de Transcrição ---
# Modo de execução: API (Nuvem) ou LOCAL (Offline na máquina)
TRANSCRIPTION_MODE=API

# Provedor ativo quando TRANSCRIPTION_MODE=API (GEMINI, OPENAI ou GLADIA)
API_PROVIDER=GEMINI

# --- Seleção de Modelos ---
# Modelos Gemini: gemini-3.1-flash-lite (Recomendado/Econômico), gemini-2.5-flash, gemini-3.5-flash
# GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-3.1-flash-lite

# Modelos Gladia: solaria-1, solaria-3
GLADIA_MODEL=solaria-1

# Modelos OpenAI
OPENAI_MODEL=whisper-1

# Modelos Locais (faster-whisper): base, small, medium, large-v3, large-v3-turbo (Recomendado)
LOCAL_WHISPER_MODEL=large-v3-turbo

# --- Credenciais de API (Substitua pelas suas chaves) ---
GEMINI_API_KEY=sua_chave_gemini_aqui
GLADIA_API_KEY=sua_chave_gladia_aqui
OPENAI_API_KEY=sua_chave_openai_aqui
